rules_version = '2';

// Rules for upstream's pipeline tests, which run against the Firestore
// emulator's Enterprise edition (firebase.enterprise.json). Pipelines read
// collection groups and the whole database, so everything is open.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
